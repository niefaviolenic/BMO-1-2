  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:splash:syntax": "find .maestro/splash -maxdepth 1 -name '*.yaml' -print0 | xargs -0 -n1 maestro check-syntax",
    "test:splash:geometry": "node scripts/verify-splash-geometry.mjs",
    "test:splash:visual": "./scripts/run-maestro.sh .maestro/splash/expression.yaml .maestro/splash/signature.yaml .maestro/splash/full.yaml",
    "test:auth:syntax": "find .maestro/auth -maxdepth 1 -name '*.yaml' -print0 | xargs -0 -n1 maestro check-syntax",
    "test:auth:visual": "./scripts/run-maestro.sh .maestro/auth/full.yaml .maestro/auth/buttons.yaml .maestro/auth/sheet-animation-delay.yaml",
    "maestro": "./scripts/run-maestro.sh",
    "code-connect:publish": "figma connect publish",
    "code-connect:parse": "figma connect parse"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "eslint-plugin-react-hooks>zod-validation-error": "^4.0.2"
    },
    "patchedDependencies": {
      "expo-modules-jsi@57.0.5": "patches/expo-modules-jsi@57.0.5.patch",
      "expo-notifications@57.0.15": "patches/expo-notifications@57.0.15.patch"
