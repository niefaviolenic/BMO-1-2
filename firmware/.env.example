# Joy Device Production Credentials Template
# Copy this file to joy-production.env or .env and fill in the device credentials.
# Set JOY_PRODUCTION_ENV_FILE when building the ESP firmware:
#   export JOY_PRODUCTION_ENV_FILE=$(pwd)/esp/joy-production.env

DEVICE_ID=joy-001
DEVICE_TOKEN=your_64_character_hex_device_token_here
